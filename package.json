{
  "name": "ksdb-studio",
  "version": "1.5.0",
  "description": "Gestionnaire de bases de données léger pour PostgreSQL et MySQL/MariaDB",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,main,app \"vite\" \"node scripts/build-main.mjs --watch\" \"wait-on tcp:5173 file:dist/main/main.js && electron . --dev\"",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:engine": "node scripts/build-main.mjs && node dist/test/engine.test.js",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist": "npm run build && electron-builder",
    "test:vpn": "node scripts/build-main.mjs && node dist/test/vpn.test.js",
    "test:update": "node scripts/build-main.mjs && node dist/test/update.test.js",
    "test:compare": "node scripts/build-main.mjs && node dist/test/compare.test.js"
  },
  "author": {
    "name": "CYBERISK",
    "email": "kanhounacademie@gmail.com"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@dagrejs/dagre": "^3.1.3",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.23",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.1.2",
    "codemirror": "^6.0.2",
    "concurrently": "^10.0.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql-formatter": "^15.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "productName": "KSDB Studio",
  "build": {
    "appId": "com.cyberisk.ksdbstudio",
    "productName": "KSDB Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/main/**",
      "dist/preload/**",
      "dist/renderer/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "KSDB Studio",
      "artifactName": "KSDB-Studio-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "CYBERISK <kanhounacademie@gmail.com>"
    },
    "artifactName": "KSDB-Studio-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "portable": {
      "artifactName": "KSDB-Studio-${version}-portable.${ext}"
    }
  },
  "homepage": "https://github.com/koyaja/KSDB-Studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/koyaja/KSDB-Studio.git"
  }
}